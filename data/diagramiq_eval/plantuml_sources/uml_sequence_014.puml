@startuml
' Diagram: Ride Allocation & Driver Acceptance
' Category: UML_SEQUENCE
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
participant "Rider" as Rider
participant "DispatchEngine" as DispatchEngine
participant "DriverMobile" as DriverMobile
participant "TripTracker" as TripTracker
Rider -> DispatchEngine : sends_message
DispatchEngine -> DriverMobile : sends_message
DriverMobile -> DispatchEngine : sends_message
@enduml
