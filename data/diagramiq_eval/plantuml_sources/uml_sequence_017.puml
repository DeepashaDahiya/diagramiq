skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
participant "VideoPlayer" as VideoPlayer
participant "ManifestServer" as ManifestServer
participant "EdgeCDNServer" as EdgeCDNServer
