@startuml
' Diagram: Distributed Redlock Mutex Acquisition
' Category: UML_SEQUENCE
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
participant "WorkerNode" as WorkerNode
participant "RedisMaster1" as RedisMaster1
participant "RedisMaster2" as RedisMaster2
participant "RedisMaster3" as RedisMaster3
WorkerNode -> RedisMaster1 : sends_message
WorkerNode -> RedisMaster2 : sends_message
WorkerNode -> RedisMaster3 : sends_message
@enduml
