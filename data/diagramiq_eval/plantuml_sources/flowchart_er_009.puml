@startuml
' Diagram: Banking Ledger Schema ERD
' Category: ER_DIAGRAM
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
rectangle "AccountHolder" as AccountHolder
rectangle "Account" as Account
rectangle "LedgerEntry" as LedgerEntry
rectangle "BankBranch" as BankBranch
AccountHolder --> Account : relates_to
Account --> LedgerEntry : relates_to
Account --> BankBranch : relates_to
@enduml
