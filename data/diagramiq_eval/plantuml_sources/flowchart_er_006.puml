@startuml
' Diagram: Real Estate Property Schema ERD
' Category: ER_DIAGRAM
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
rectangle "PropertyListing" as PropertyListing
rectangle "Agent" as Agent
rectangle "Owner" as Owner
rectangle "OfferRecord" as OfferRecord
