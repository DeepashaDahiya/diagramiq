@startuml
' Diagram: Flight Reservation Engine
' Category: UML_CLASS
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
class Flight {
  +flightId
  +execute()
}
class Airline {
  +airlineId
  +execute()
}
class Passenger {
  +passengerId
  +execute()
}
class Ticket {
  +ticketId
  +execute()
}
class Airport {
  +airportId
  +execute()
}
Passenger --> Ticket : associates
Ticket --> Flight : associates
Airline --> Flight : associates
Flight --> Airport : associates
@enduml
