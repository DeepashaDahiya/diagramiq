@startuml
' Diagram: Parking Lot Controller
' Category: UML_CLASS
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
class ParkingLot {
  +parkinglotId
  +execute()
}
class ParkingSpot {
  +parkingspotId
  +execute()
}
class ParkingTicket {
  +parkingticketId
  +execute()
}
class Vehicle {
  +vehicleId
  +execute()
}
class PaymentKiosk {
  +paymentkioskId
  +execute()
}
ParkingLot --> ParkingSpot : associates
Vehicle --> ParkingTicket : associates
ParkingTicket --> ParkingSpot : associates
ParkingTicket --> PaymentKiosk : associates
@enduml
