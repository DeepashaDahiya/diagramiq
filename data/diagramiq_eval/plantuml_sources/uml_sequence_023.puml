@startuml
' Diagram: Webhook Delivery with Retry Backoff
' Category: UML_SEQUENCE
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
participant "PublisherApp" as PublisherApp
participant "WebhookWorker" as WebhookWorker
participant "SubscriberEndpoint" as SubscriberEndpoint
participant "DeadLetterQueue" as DeadLetterQueue
PublisherApp -> WebhookWorker : sends_message
WebhookWorker -> SubscriberEndpoint : sends_message
WebhookWorker -> DeadLetterQueue : sends_message
@enduml
