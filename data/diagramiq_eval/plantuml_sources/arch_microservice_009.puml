@startuml
' Diagram: Multi-Channel Notification Hub
' Category: SW_ARCHITECTURE
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
node "EventProducer" as EventProducer
node "SQSQueue" as SQSQueue
node "NotificationWorker" as NotificationWorker
node "TwilioSMS" as TwilioSMS
node "SendGridEmail" as SendGridEmail
EventProducer --> SQSQueue : calls
SQSQueue --> NotificationWorker : calls
NotificationWorker --> TwilioSMS : calls
NotificationWorker --> SendGridEmail : calls
@enduml
