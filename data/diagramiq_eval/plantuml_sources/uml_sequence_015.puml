@startuml
' Diagram: Distributed Two-Phase Commit Protocol
' Category: UML_SEQUENCE
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
participant "TxCoordinator" as TxCoordinator
participant "ParticipantA" as ParticipantA
participant "ParticipantB" as ParticipantB
participant "AuditLog" as AuditLog
TxCoordinator -> ParticipantA : sends_message
TxCoordinator -> ParticipantB : sends_message
TxCoordinator -> AuditLog : sends_message
@enduml
