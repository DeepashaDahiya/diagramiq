@startuml
' Diagram: User Email Account Verification
' Category: UML_SEQUENCE
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
participant "NewUser" as NewUser
participant "FrontendApp" as FrontendApp
participant "RegistrationAPI" as RegistrationAPI
participant "EmailDispatcher" as EmailDispatcher
NewUser -> FrontendApp : sends_message
FrontendApp -> RegistrationAPI : sends_message
RegistrationAPI -> EmailDispatcher : sends_message
@enduml
