@startuml
' Diagram: Git Push SSH Key Exchange & Webhook
' Category: UML_SEQUENCE
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
participant "DeveloperCLI" as DeveloperCLI
participant "SSHDaemon" as SSHDaemon
participant "GitRepository" as GitRepository
participant "CIWebhookTrigger" as CIWebhookTrigger
DeveloperCLI -> SSHDaemon : sends_message
SSHDaemon -> GitRepository : sends_message
GitRepository -> CIWebhookTrigger : sends_message
@enduml
