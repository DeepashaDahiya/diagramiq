@startuml
' Diagram: Library Management System
' Category: UML_CLASS
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
class Book {
  +bookId
  +execute()
}
class Author {
  +authorId
  +execute()
}
class Member {
  +memberId
  +execute()
}
class Loan {
  +loanId
  +execute()
}
class Librarian {
  +librarianId
  +execute()
}
Member --> Loan : associates
Loan --> Book : associates
Author --> Book : associates
Librarian --> Loan : associates
@enduml
