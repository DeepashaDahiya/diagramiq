@startuml
' Diagram: Video Streaming Platform
' Category: UML_CLASS
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
class User {
  +userId
  +execute()
}
class Video {
  +videoId
  +execute()
}
class Playlist {
  +playlistId
  +execute()
}
class Subscription {
  +subscriptionId
  +execute()
}
class Channel {
  +channelId
  +execute()
}
User --> Subscription : associates
Subscription --> Channel : associates
Channel --> Video : associates
User --> Playlist : associates
@enduml
