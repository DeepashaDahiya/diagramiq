@startuml
' Diagram: Online Food Delivery
' Category: UML_CLASS
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
class Customer {
  +customerId
  +execute()
}
class Restaurant {
  +restaurantId
  +execute()
}
class MenuItem {
  +menuitemId
  +execute()
}
class Order {
  +orderId
  +execute()
}
class Courier {
  +courierId
  +execute()
}
Customer --> Order : associates
Order --> MenuItem : associates
Restaurant --> MenuItem : associates
Courier --> Order : associates
@enduml
