@startuml
' Diagram: Document Management Engine
' Category: UML_CLASS
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
class Document {
  +documentId
  +execute()
}
class Folder {
  +folderId
  +execute()
}
class Permission {
  +permissionId
  +execute()
}
class UserGroup {
  +usergroupId
  +execute()
}
class VersionHistory {
  +versionhistoryId
  +execute()
}
Folder --> Document : associates
Document --> VersionHistory : associates
Document --> Permission : associates
UserGroup --> Permission : associates
@enduml
