@startuml
' Diagram: CDN Edge Cache Model
' Category: UML_CLASS
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
class EdgeServer {
  +edgeserverId
  +execute()
}
class OriginServer {
  +originserverId
  +execute()
}
class CacheEntry {
  +cacheentryId
  +execute()
}
class RoutingRule {
  +routingruleId
  +execute()
}
class ClientSession {
  +clientsessionId
  +execute()
}
EdgeServer --> CacheEntry : associates
EdgeServer --> OriginServer : associates
ClientSession --> EdgeServer : associates
EdgeServer --> RoutingRule : associates
@enduml
