@startuml
' Diagram: Banking & Account Management
' Category: UML_CLASS
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
class BankAccount {
  #accountNumber
  #balance
  +deposit()
  +withdraw()*
}
class SavingsAccount {
  +interestRate
  +applyInterest()
  +withdraw()
}
class CheckingAccount {
  +overdraftLimit
  +withdraw()
}
class Transaction {
  +txId
  +amount
  +timestamp
  +execute()
}
class BankCustomer {
  +name
  +ssn
  +openAccount()
}
SavingsAccount --> BankAccount : inherits
CheckingAccount --> BankAccount : inherits
BankCustomer --> BankAccount : owns
BankAccount --> Transaction : records
@enduml
