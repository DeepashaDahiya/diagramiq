@startuml
' Diagram: Supply Chain Logistics
' Category: UML_CLASS
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
class Shipment {
  +shipmentId
  +execute()
}
class Carrier {
  +carrierId
  +execute()
}
class RouteCheckpoint {
  +routecheckpointId
  +execute()
}
class Consignee {
  +consigneeId
  +execute()
}
class Manifest {
  +manifestId
  +execute()
}
Carrier --> Shipment : associates
Shipment --> RouteCheckpoint : associates
Shipment --> Consignee : associates
Shipment --> Manifest : associates
@enduml
