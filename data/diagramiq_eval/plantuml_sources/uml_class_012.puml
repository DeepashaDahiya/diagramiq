@startuml
' Diagram: Vehicle Rental System
' Category: UML_CLASS
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
class Customer {
  +customerId
  +execute()
}
class RentalContract {
  +rentalcontractId
  +execute()
}
class Car {
  +carId
  +execute()
}
class InsurancePolicy {
  +insurancepolicyId
  +execute()
}
class Location {
  +locationId
  +execute()
}
Customer --> RentalContract : associates
RentalContract --> Car : associates
RentalContract --> InsurancePolicy : associates
Car --> Location : associates
@enduml
