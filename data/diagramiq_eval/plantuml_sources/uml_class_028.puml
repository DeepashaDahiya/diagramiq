@startuml
' Diagram: Cloud VPC Infrastructure
' Category: UML_CLASS
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
class VPC {
  +vpcId
  +execute()
}
class Subnet {
  +subnetId
  +execute()
}
class EC2Instance {
  +ec2instanceId
  +execute()
}
class SecurityGroup {
  +securitygroupId
  +execute()
}
class RouteTable {
  +routetableId
  +execute()
}
VPC --> Subnet : associates
Subnet --> EC2Instance : associates
EC2Instance --> SecurityGroup : associates
Subnet --> RouteTable : associates
@enduml
