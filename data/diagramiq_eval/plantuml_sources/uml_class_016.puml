@startuml
' Diagram: Learning Management System
' Category: UML_CLASS
skinparam backgroundColor #0f172a
skinparam defaultFontColor #f8fafc
skinparam classBackgroundColor #1e293b
skinparam classBorderColor #38bdf8
class Course {
  +courseId
  +execute()
}
class Assignment {
  +assignmentId
  +execute()
}
class Submission {
  +submissionId
  +execute()
}
class Student {
  +studentId
  +execute()
}
class GradeBook {
  +gradebookId
  +execute()
}
Student --> Submission : associates
Submission --> Assignment : associates
Course --> Assignment : associates
Course --> GradeBook : associates
@enduml
